{
  "openapi": "3.0.3",
  "info": {
    "title": "CarChief API Service",
    "version": "1.0.0",
    "description": "CarChief OpenAPI Specification and Contract Surface"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health status response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "example": "2026-08-07T00:00:00.000Z" }
                  },
                  "required": ["status", "timestamp"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/public": {
      "get": {
        "summary": "Get public configuration and branding summary",
        "operationId": "getPublicConfig",
        "responses": {
          "200": {
            "description": "Public branding and site configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo-session": {
      "post": {
        "summary": "Mint a stand-in demo customer session (DEC-PUB-AUTH-BOUNDARY, PUB-22, D01-P06-T003) — never a production identity",
        "operationId": "startDemoSession",
        "responses": {
          "201": {
            "description": "A CustomerBuyer stand-in session was minted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DemoSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "summary": "Get vehicle domain summaries",
        "operationId": "getVehicles",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["latest_arrivals", "premium_teaser", "discounted", "clearance", "featured", "browse"]
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "UG" }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["arrival", "premium", "clearance", "best_offer"]
            }
          },
          {
            "name": "searchQuery",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Toyota" }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Toyota" }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Corolla" }
          },
          {
            "name": "bodyStyle",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "SUV" }
          },
          {
            "name": "fuelType",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Hybrid" }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Automatic" }
          },
          {
            "name": "driveTrain",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "4WD" }
          },
          {
            "name": "stockType",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "J" }
          },
          {
            "name": "locationStatus",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "In Japan" }
          },
          {
            "name": "yearMin",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 2018 }
          },
          {
            "name": "yearMax",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 2024 }
          },
          {
            "name": "priceMin",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 5000 }
          },
          {
            "name": "priceMax",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 25000 }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["newest", "price_asc", "price_desc", "year_desc", "year_asc", "mileage_asc"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 12 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of vehicle summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/VehicleSummary" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vehicles/search": {
      "get": {
        "summary": "Search vehicle inventory with dynamic facets, sorting and pagination",
        "operationId": "searchVehicles",
        "parameters": [
          {
            "name": "searchQuery",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Toyota" }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Toyota" }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Corolla" }
          },
          {
            "name": "bodyStyle",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "SUV" }
          },
          {
            "name": "fuelType",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Hybrid" }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Automatic" }
          },
          {
            "name": "driveTrain",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "4WD" }
          },
          {
            "name": "stockType",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "J" }
          },
          {
            "name": "locationStatus",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "In Japan" }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "UG" }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "premium" }
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "latest_arrivals" }
          },
          {
            "name": "yearMin",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 2018 }
          },
          {
            "name": "yearMax",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 2024 }
          },
          {
            "name": "priceMin",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 5000 }
          },
          {
            "name": "priceMax",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "example": 25000 }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["newest", "price_asc", "price_desc", "year_desc", "year_asc", "mileage_asc"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "example": 12 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated vehicle search result with facets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleSearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vehicles/{idOrSlug}": {
      "get": {
        "summary": "Get public vehicle detail by ID, chassis number, or stable slug",
        "operationId": "getVehicleDetail",
        "parameters": [
          {
            "name": "idOrSlug",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "veh-1" }
          }
        ],
        "responses": {
          "200": {
            "description": "Public vehicle detail and categorized media",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleDetail"
                }
              }
            }
          },
          "404": {
            "description": "Vehicle not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/freight/destinations": {
      "get": {
        "summary": "Get supported freight destinations catalog (D01-ASM-001)",
        "operationId": "getFreightDestinations",
        "responses": {
          "200": {
            "description": "List of supported freight destinations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/FreightDestination" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/freight/ports": {
      "get": {
        "summary": "Get supported freight arrival ports catalog (D01-ASM-001)",
        "operationId": "getFreightPorts",
        "responses": {
          "200": {
            "description": "List of supported freight arrival ports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/FreightPort" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/freight/estimate": {
      "post": {
        "summary": "Request a freight estimate lookup (D01-ASM-001 — no formula, no computed total)",
        "operationId": "postFreightEstimate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FreightEstimateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic estimate lookup outcome; no monetary total is present while DEC-PUB-FREIGHT-MODEL is unresolved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FreightEstimateResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported destination, port, or dimensions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/enquiries": {
      "post": {
        "summary": "Submit a general, vehicle, price-request or Premium Vehicle enquiry (PUB-13, PUB-14, PUB-15, PUB-28, PUB-34, D01-P05-T004, D01-P06-T001) — independent of DEC-PUB-FREIGHT-MODEL",
        "operationId": "postEnquiry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnquiryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Enquiry received and persisted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnquiryResponse" }
              }
            }
          },
          "200": {
            "description": "An identical enquiry was already on file; the original receipt is returned (duplicate: true)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnquiryResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid, missing or unsupported field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Staff-facing lead list proof operation (PUB-16, D01-P06-T001) — the regression fix proving a submitted enquiry is retrievable through the Salesperson service boundary, not only writable",
        "operationId": "listLeads",
        "responses": {
          "200": {
            "description": "All persisted leads, most-recently-received last",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeadListResponse" }
              }
            }
          },
          "401": {
            "description": "No authenticated staff identity supplied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Authenticated identity lacks the 'read:leads' permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/enquiries/{id}": {
      "get": {
        "summary": "Staff-facing lead read-by-ID proof operation (PUB-16, D01-P06-T001)",
        "operationId": "getLeadById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "enq-1723368000000-0"
          }
        ],
        "responses": {
          "200": {
            "description": "The canonical lead record for this enquiry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeadRecord" }
              }
            }
          },
          "401": {
            "description": "No authenticated staff identity supplied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Authenticated identity lacks the 'read:leads' permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No enquiry exists with this id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/__reset": {
      "post": {
        "summary": "Deterministic non-production data reset",
        "operationId": "resetData",
        "responses": {
          "200": {
            "description": "Reset operation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Data reset successfully" }
                  },
                  "required": ["success", "message"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicConfig": {
        "type": "object",
        "properties": {
          "siteName": { "type": "string", "example": "CarChief" },
          "currency": { "type": "string", "example": "USD" },
          "contactPhone": { "type": "string", "example": "+256 700 000 000" },
          "liveAuctionUrl": {
            "type": "string",
            "description": "Approved external Live Auction destination (PUB-27, D01-ASM-002). Absent when no destination is approved — the account-gated Live Auction entry is hidden, never a placeholder link (RULE-10).",
            "example": "https://auctions.example.com/live"
          }
        },
        "required": ["siteName", "currency", "contactPhone"]
      },
      "SessionClaims": {
        "type": "object",
        "description": "Stand-in demo JWT claims (DEC-PUB-AUTH-BOUNDARY). Never a production identity.",
        "properties": {
          "sub": { "type": "string", "example": "user-123" },
          "email": { "type": "string", "example": "user@carchief.com" },
          "role": {
            "type": "string",
            "enum": ["PublicVisitor", "CustomerBuyer", "Salesperson", "StockController", "FinanceManager", "SystemAdmin"],
            "example": "CustomerBuyer"
          },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "exp": { "type": "integer", "description": "Unix seconds", "example": 1723371600 }
        },
        "required": ["sub", "email", "role", "permissions", "exp"]
      },
      "DemoSessionResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "claims": { "$ref": "#/components/schemas/SessionClaims" },
          "nonProduction": { "type": "boolean", "example": true }
        },
        "required": ["token", "claims", "nonProduction"]
      },
      "VehicleSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "veh-1" },
          "chassisNumber": { "type": "string", "example": "NZE141-1234567" },
          "make": { "type": "string", "example": "Toyota" },
          "model": { "type": "string", "example": "Corolla Axio" },
          "year": { "type": "integer", "example": 2021 },
          "priceUsd": { "type": "number", "example": 8500 },
          "status": { "type": "string", "example": "Available" },
          "category": { "type": "string", "example": "premium" },
          "locationStatus": { "type": "string", "example": "In Japan" },
          "createdAt": { "type": "string", "example": "2026-08-08T00:00:00.000Z" },
          "images": {
            "type": "array",
            "items": { "type": "string" }
          },
          "featured": { "type": "boolean", "example": true },
          "stockType": { "type": "string", "example": "J" },
          "destinationPort": { "type": "string", "example": "Mombasa" },
          "discountPercent": { "type": "number", "example": 5 },
          "bodyStyle": { "type": "string", "example": "Sedan" },
          "fuelType": { "type": "string", "example": "Petrol" },
          "transmission": { "type": "string", "example": "Automatic" },
          "driveTrain": { "type": "string", "example": "2WD" },
          "mileage": { "type": "integer", "example": 45000 },
          "etd": { "type": "string", "example": "2026-08-15T00:00:00.000Z" },
          "eta": { "type": "string", "example": "2026-09-01T00:00:00.000Z" },
          "requestPrice": { "type": "boolean", "example": false }
        },
        "required": ["id", "chassisNumber", "make", "model", "year", "priceUsd", "status"]
      },
      "CategorizedPublicMedia": {
        "type": "object",
        "properties": {
          "gallery": {
            "type": "array",
            "items": { "type": "string" }
          },
          "auctionPictures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "auctionSheet": {
            "type": "array",
            "items": { "type": "string" }
          },
          "japanPictures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "durbanPictures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "showAuctionPictures": { "type": "boolean", "example": false },
          "showJapanPictures": { "type": "boolean", "example": true },
          "showDurbanPictures": { "type": "boolean", "example": false },
          "totalPicturesCount": { "type": "integer", "example": 5 }
        },
        "required": ["gallery", "totalPicturesCount"]
      },
      "VehicleDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "veh-1" },
          "chassisNumber": { "type": "string", "example": "NZE141-1234567" },
          "slug": { "type": "string", "example": "2021-toyota-corolla-axio-veh-1" },
          "make": { "type": "string", "example": "Toyota" },
          "model": { "type": "string", "example": "Corolla Axio" },
          "year": { "type": "integer", "example": 2021 },
          "status": { "type": "string", "example": "Available" },
          "priceState": { "type": "string", "enum": ["priced", "request_price"], "example": "priced" },
          "priceUsd": { "type": "number", "example": 8500 },
          "requestPrice": { "type": "boolean", "example": false },
          "discountPercent": { "type": "number", "example": 5 },
          "discountedPriceUsd": { "type": "number", "example": 8075 },
          "category": { "type": "string", "example": "premium" },
          "locationStatus": { "type": "string", "example": "In Japan" },
          "stockType": { "type": "string", "example": "J" },
          "destinationPort": { "type": "string", "example": "Mombasa" },
          "bodyStyle": { "type": "string", "example": "Sedan" },
          "fuelType": { "type": "string", "example": "Petrol" },
          "transmission": { "type": "string", "example": "Automatic" },
          "driveTrain": { "type": "string", "example": "2WD" },
          "mileage": { "type": "integer", "example": 32000 },
          "engineSize": { "type": "string", "example": "1500 cc" },
          "color": { "type": "string", "example": "White" },
          "modelCode": { "type": "string", "example": "DBA-NZE141" },
          "versionClass": { "type": "string", "example": "1.5X" },
          "registerYear": { "type": "string", "example": "2021/04" },
          "mfgYear": { "type": "string", "example": "2021/03" },
          "dimensions": {
            "type": "object",
            "properties": {
              "lengthMm": { "type": "number", "example": 4410 },
              "widthMm": { "type": "number", "example": 1695 },
              "heightMm": { "type": "number", "example": 1460 },
              "m3": { "type": "number", "example": 10.91 }
            }
          },
          "etd": { "type": "string", "example": "2026-08-20T00:00:00.000Z" },
          "eta": { "type": "string", "example": "2026-09-10T00:00:00.000Z" },
          "featured": { "type": "boolean", "example": true },
          "countryEligibility": {
            "type": "array",
            "items": { "type": "string" }
          },
          "media": { "$ref": "#/components/schemas/CategorizedPublicMedia" }
        },
        "required": ["id", "chassisNumber", "slug", "make", "model", "year", "status", "priceState", "requestPrice", "media"]
      },
      "FacetCount": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Toyota" },
          "count": { "type": "integer", "example": 15 }
        },
        "required": ["name", "count"]
      },
      "RangeFacet": {
        "type": "object",
        "properties": {
          "min": { "type": "number", "example": 2015 },
          "max": { "type": "number", "example": 2024 }
        },
        "required": ["min", "max"]
      },
      "VehicleFacets": {
        "type": "object",
        "properties": {
          "makes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FacetCount" }
          },
          "bodyStyles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FacetCount" }
          },
          "fuelTypes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FacetCount" }
          },
          "yearRange": { "$ref": "#/components/schemas/RangeFacet" },
          "priceRange": { "$ref": "#/components/schemas/RangeFacet" }
        },
        "required": ["makes", "bodyStyles", "fuelTypes", "yearRange", "priceRange"]
      },
      "VehicleSearchResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VehicleSummary" }
          },
          "total": { "type": "integer", "example": 25 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 12 },
          "totalPages": { "type": "integer", "example": 3 },
          "hasNextPage": { "type": "boolean", "example": true },
          "hasPrevPage": { "type": "boolean", "example": false },
          "facets": { "$ref": "#/components/schemas/VehicleFacets" }
        },
        "required": ["items", "total", "page", "limit", "totalPages", "hasNextPage", "hasPrevPage", "facets"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": { "type": "integer", "example": 400 },
          "message": { "type": "string", "example": "Bad Request" },
          "correlationId": { "type": "string", "example": "corr-12345" },
          "field": { "type": "string", "example": "destinationCode" }
        },
        "required": ["statusCode", "message", "correlationId"]
      },
      "FreightDestination": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "UG" },
          "name": { "type": "string", "example": "Uganda" },
          "country": { "type": "string", "example": "Uganda" }
        },
        "required": ["code", "name", "country"]
      },
      "FreightPort": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "MBA" },
          "name": { "type": "string", "example": "Mombasa" },
          "country": { "type": "string", "example": "Kenya" }
        },
        "required": ["code", "name", "country"]
      },
      "FreightEstimateDimensions": {
        "type": "object",
        "properties": {
          "lengthMm": { "type": "number", "example": 4500 },
          "widthMm": { "type": "number", "example": 1800 },
          "heightMm": { "type": "number", "example": 1500 }
        },
        "required": ["lengthMm", "widthMm", "heightMm"]
      },
      "FreightEstimateRequest": {
        "type": "object",
        "properties": {
          "destinationCode": { "type": "string", "example": "UG" },
          "portCode": { "type": "string", "example": "MBA" },
          "dimensions": { "$ref": "#/components/schemas/FreightEstimateDimensions" }
        },
        "required": ["destinationCode", "portCode"]
      },
      "FreightEstimateResponse": {
        "type": "object",
        "properties": {
          "outcome": { "type": "string", "enum": ["estimate_unavailable_pending_rate"], "example": "estimate_unavailable_pending_rate" },
          "destinationCode": { "type": "string", "example": "UG" },
          "portCode": { "type": "string", "example": "MBA" },
          "rateStatus": { "type": "string", "enum": ["active", "stale", "no_rate"], "example": "active" },
          "currency": { "type": "string", "example": "USD" },
          "rateEffectiveFrom": { "type": "string", "example": "2026-06-01T00:00:00.000Z" },
          "rateEffectiveTo": { "type": "string", "example": "2026-12-01T00:00:00.000Z" },
          "message": { "type": "string", "example": "Shipping estimate unavailable — pending a confirmed freight rate." }
        },
        "required": ["outcome", "destinationCode", "portCode", "rateStatus", "message"]
      },
      "EnquiryEstimateSnapshot": {
        "type": "object",
        "properties": {
          "destinationCode": { "type": "string", "example": "UG" },
          "portCode": { "type": "string", "example": "MBA" },
          "rateStatus": { "type": "string", "enum": ["active", "stale", "no_rate"], "example": "active" },
          "currency": { "type": "string", "example": "USD" },
          "rateEffectiveFrom": { "type": "string", "example": "2026-06-01T00:00:00.000Z" },
          "rateEffectiveTo": { "type": "string", "example": "2026-12-01T00:00:00.000Z" },
          "message": { "type": "string", "example": "Shipping estimate unavailable — pending a confirmed freight rate." }
        },
        "required": ["destinationCode", "portCode", "rateStatus", "message"]
      },
      "EnquiryRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Jane Doe" },
          "email": { "type": "string", "example": "jane@example.com" },
          "phone": { "type": "string", "example": "+256 700 111 222" },
          "message": { "type": "string", "example": "Please send a shipping quotation for this vehicle." },
          "consent": {
            "type": "boolean",
            "description": "Required (D01-P06-T002, PUB-14): explicit agreement to be contacted, validated server-side beyond native browser checks.",
            "example": true
          },
          "vehicleSlug": { "type": "string", "example": "2021-toyota-corolla-axio-veh-1" },
          "destinationCode": { "type": "string", "example": "UG" },
          "portCode": { "type": "string", "example": "MBA" },
          "enquiryType": {
            "type": "string",
            "enum": ["general", "vehicle", "price-request", "premium-vehicle"],
            "example": "vehicle"
          },
          "source": {
            "type": "string",
            "enum": ["form", "whatsapp", "email", "call"],
            "example": "form"
          },
          "preferredMake": { "type": "string", "example": "Toyota" },
          "preferredModel": { "type": "string", "example": "Corolla" },
          "preferredDriveSide": { "type": "string", "enum": ["left", "right"], "example": "right" },
          "preferredYear": { "type": "integer", "example": 2021 },
          "targetPriceUsd": { "type": "number", "example": 12000 }
        },
        "required": ["name", "email", "phone", "message", "consent"]
      },
      "EnquiryResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "enq-1723368000000-0" },
          "receivedAt": { "type": "string", "example": "2026-08-11T12:00:00.000Z" },
          "status": { "type": "string", "enum": ["received"], "example": "received" },
          "duplicate": { "type": "boolean", "example": false },
          "enquiryType": {
            "type": "string",
            "enum": ["general", "vehicle", "price-request", "premium-vehicle"],
            "example": "vehicle"
          },
          "source": {
            "type": "string",
            "enum": ["form", "whatsapp", "email", "call"],
            "example": "form"
          },
          "vehicleSlug": { "type": "string", "example": "2021-toyota-corolla-axio-veh-1" },
          "estimateSnapshot": { "$ref": "#/components/schemas/EnquiryEstimateSnapshot" }
        },
        "required": ["id", "receivedAt", "status", "duplicate", "enquiryType", "source"]
      },
      "LeadRecord": {
        "type": "object",
        "description": "Canonical staff-visible lead record (PUB-16, D01-P06-T001) — the regression fix proving a submitted enquiry is retrievable through the Salesperson service boundary.",
        "properties": {
          "id": { "type": "string", "example": "enq-1723368000000-0" },
          "receivedAt": { "type": "string", "example": "2026-08-11T12:00:00.000Z" },
          "status": { "type": "string", "enum": ["New", "Contacted", "InProgress", "Sold", "Archived"], "example": "New" },
          "enquiryType": {
            "type": "string",
            "enum": ["general", "vehicle", "price-request", "premium-vehicle"],
            "example": "vehicle"
          },
          "source": {
            "type": "string",
            "enum": ["form", "whatsapp", "email", "call"],
            "example": "form"
          },
          "name": { "type": "string", "example": "Jane Doe" },
          "email": { "type": "string", "example": "jane@example.com" },
          "phone": { "type": "string", "example": "+256 700 111 222" },
          "message": { "type": "string", "example": "Please send a shipping quotation for this vehicle." },
          "consent": { "type": "boolean", "example": true },
          "vehicleSlug": { "type": "string", "example": "2021-toyota-corolla-axio-veh-1" },
          "estimateSnapshot": { "$ref": "#/components/schemas/EnquiryEstimateSnapshot" },
          "duplicateResubmissionCount": { "type": "integer", "example": 0 },
          "preferredMake": { "type": "string", "example": "Toyota" },
          "preferredModel": { "type": "string", "example": "Corolla" },
          "preferredDriveSide": { "type": "string", "enum": ["left", "right"], "example": "right" },
          "preferredYear": { "type": "integer", "example": 2021 },
          "targetPriceUsd": { "type": "number", "example": 12000 }
        },
        "required": [
          "id",
          "receivedAt",
          "status",
          "enquiryType",
          "source",
          "name",
          "email",
          "phone",
          "message",
          "consent",
          "duplicateResubmissionCount"
        ]
      },
      "LeadListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LeadRecord" }
          },
          "total": { "type": "integer", "example": 1 }
        },
        "required": ["items", "total"]
      }
    }
  }
}
