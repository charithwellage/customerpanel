  "dynamicRoutes": [
    {
      "page": "/allstock/[slug]",
      "regex": "^/allstock/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/allstock/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/[...path]",
      "regex": "^/api/v1/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/v1/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/branches/[branch]",
      "regex": "^/branches/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbranch": "nxtPbranch"
      },
      "namedRegex": "^/branches/(?<nxtPbranch>[^/]+?)(?:/)?$"
    },
    {
      "page": "/content/[slug]",
