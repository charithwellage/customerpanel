{
  "name": "CarChief Customer Portal",
  "short_name": "CarChief",
  "id": "/carchief-customer-portal",
  "description": "CarChief Customer Operations Portal - Track Japanese auction vehicles, manage shipments, inspect invoices and demand orders.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#dc2626",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
