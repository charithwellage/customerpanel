# Customer Application Environment Variables Example (Committed)

# Port served by `pnpm --filter @carchief/customer-app dev` and `... preview`.
PORT=3001

# Semantic theme id. Anything unknown resolves to the approved `carchief` default.
VITE_THEME_ID=carchief

# Where the dev/preview server forwards same-origin /api/v1 calls. This is read
# by the Node process that serves the bundle, so it may safely name a
# container-internal host (Compose sets it to http://mock-api:4000).
CUSTOMER_API_PROXY_TARGET=http://127.0.0.1:4000

# Leave VITE_API_BASE_URL unset for the normal same-origin + proxy setup above.
# A VITE_* value is inlined into the static bundle at build time and runs in the
# browser, so only set this to an origin the browser itself can reach — never a
# container-internal hostname.
# VITE_API_BASE_URL=http://127.0.0.1:4000
