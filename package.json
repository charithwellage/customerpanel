{
  "name": "carchief-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "CarChief Frontend Rebuild Monorepo",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "build": "pnpm --recursive run build",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:integration": "vitest run packages/api-client",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
