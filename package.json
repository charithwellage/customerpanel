{
  "name": "carchief-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "CarChief Frontend Rebuild Monorepo",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive --sort run typecheck",
    "build": "pnpm --recursive --sort run build",
    "api:generate": "node openapi/generate.mjs",
    "mock:reset": "node apps/mock-api/scripts/reset.mjs",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "quality": "pnpm lint && pnpm typecheck && pnpm test:boundaries",
    "test": "vitest run",
    "test:contract": "vitest run packages/api-client",
    "test:integration": "vitest run packages/api-client",
    "test:seo-routes": "vitest run apps/public-web/src/__tests__/seo-routes.test.ts",
    "test:metadata": "vitest run apps/public-web/src/__tests__/metadata.test.ts",
    "test:traceability": "vitest run tests/traceability/requirement-coverage.test.ts",
    "test:security": "vitest run apps/public-web/src/__tests__/security-projection.test.ts apps/mock-api/src/__tests__/security-projection.test.ts",
    "build:production": "NODE_ENV=production pnpm --recursive --sort run build",
    "test:production-guard": "vitest run apps/public-web/src/__tests__/production-guard.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
